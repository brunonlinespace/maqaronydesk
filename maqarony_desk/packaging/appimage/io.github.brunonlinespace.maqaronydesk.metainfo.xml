<?xml version='1.0' encoding='UTF-8'?>
<component type="desktop-application">
  <id>io.github.brunonlinespace.maqaronydesk</id>
  <name>MaqaronyDesk</name>
  <summary>Workspace-scale Markdown editor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      MaqaronyDesk discovers, edits, previews, and organizes Markdown documents
      across registered workspaces.
    </p>
    <p>
      It combines MaqaronyPad source editing and preview with folder dashboards,
      drag-and-drop organization, and asynchronous scanning for large workspaces.
    </p>
  </description>
  <launchable type="desktop-id">maqaronydesk.desktop</launchable>
  <developer id="io.github.brunonlinespace">
    <name>Bruno Machado</name>
  </developer>
  <url type="homepage">https://github.com/brunonlinespace/maqaronydesk</url>
  <url type="bugtracker">https://github.com/brunonlinespace/maqaronydesk/issues</url>
  <provides>
    <binary>maqaronydesk</binary>
    <mediatype>text/markdown</mediatype>
  </provides>
  <releases>
    <release version="1.0.0" date="2026-11-02"><description><p>Final MaqaronyDesk 1.0.0 promotion of x21.7 with no editor, workspace or artwork changes.</p></description></release>
  </releases>
  <content_rating type="oars-1.1" />
